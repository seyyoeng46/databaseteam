<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 이미지 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop"
        android:contentDescription=""/>

    <!-- 컨텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- 앱 로고 -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/app_logo"
            android:contentDescription="앱 로고"
            android:layout_marginBottom="20dp"/>

        <!-- 앱 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="하루결"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#4A7A3A"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <!-- 슬로건 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="꾸준한 하루를 위한 일정 관리"
            android:textSize="14sp"
            android:textColor="#8FA882"
            android:layout_marginBottom="80dp"/>

        <!-- 구글 로그인 버튼 -->
        <LinearLayout
            android:id="@+id/btn_google_login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_google_button"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_google_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google"
                android:layout_marginEnd="12dp"
                android:contentDescription="Google"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google로 시작하기"
                android:textSize="16sp"
                android:textColor="#3C3C3C"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>