<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7F2">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일기"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2C2C2A"
                android:layout_marginEnd="14dp"/>

            <EditText
                android:id="@+id/et_search_diary"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_input"
                android:hint="검색"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#2C2C2A"
                android:textColorHint="#B4B2A9"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:id="@+id/btn_calendar_search"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_month_btn"
                android:padding="10dp"
                android:src="@drawable/ic_calendar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="날짜 검색"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:background="#E8E8E0"/>

    </LinearLayout>

    <!-- FAB 버튼 (ImageView로 변경) -->
    <ImageView
        android:id="@+id/btn_add_diary"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_circle_green"
        android:padding="16dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="일기 추가"/>

    <!-- 일기 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_diary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top"
        android:layout_above="@id/btn_add_diary"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"/>

</RelativeLayout>