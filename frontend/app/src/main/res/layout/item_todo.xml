<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_routine_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- 투두 내용 -->
    <TextView
        android:id="@+id/cb_todo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="투두 항목"
        android:textColor="#2C2C2A"
        android:textSize="14sp"/>

    <!-- 수정 버튼 -->
    <TextView
        android:id="@+id/btn_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="수정"
        android:textSize="12sp"
        android:textColor="#639922"
        android:background="@drawable/bg_btn_edit"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- 삭제 버튼 -->
    <TextView
        android:id="@+id/btn_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제"
        android:textSize="12sp"
        android:textColor="#A32D2D"
        android:background="@drawable/bg_btn_delete"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>