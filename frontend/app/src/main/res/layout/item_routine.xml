<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_routine_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- 상단: 루틴 이름 + 요일 태그 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_routine_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="루틴 이름"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2C2C2A"/>

        <!-- 요일 태그 (LinearLayout으로 여러 개 추가 가능) -->
        <LinearLayout
            android:id="@+id/ll_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>

    </LinearLayout>

    <!-- 알람 목록 -->
    <LinearLayout
        android:id="@+id/ll_alarms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"/>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#F0EFE8"
        android:layout_marginBottom="10dp"/>

    <!-- 하단: 수정/삭제 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수정"
            android:textSize="12sp"
            android:textColor="#639922"
            android:background="@drawable/bg_btn_edit"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제"
            android:textSize="12sp"
            android:textColor="#A32D2D"
            android:background="@drawable/bg_btn_delete"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>