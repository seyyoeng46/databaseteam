<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7F2">

    <!-- 하단 등록 버튼 (고정) -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btn_save_diary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="등록"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_register"
            android:stateListAnimator="@null"/>

    </LinearLayout>

    <!-- 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footer"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="25dp">

            <!-- 헤더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_back"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="뒤로가기"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_date_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘 기록"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2C2C2A"/>

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="#E8E8E0"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

            <!-- 완료한 투두 태그 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_todo_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="#E8E8E0"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- 일기 제목 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일기 제목"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#888780"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_diary_title"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_edit_input"
                    android:hint="내용을 입력해주세요."
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#2C2C2A"
                    android:textColorHint="#B4B2A9"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"/>

            </LinearLayout>

            <!-- 일기 내용 섹션 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일기 내용"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#888780"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_diary_content"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_edit_input"
                    android:hint="내용을 입력해주세요."
                    android:gravity="top|start"
                    android:padding="14dp"
                    android:textColor="#2C2C2A"
                    android:textColorHint="#B4B2A9"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>