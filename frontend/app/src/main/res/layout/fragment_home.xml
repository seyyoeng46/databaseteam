<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7F2"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- To-do 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_green"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <!-- 카드 헤더 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:id="@+id/btn_prev_day"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_back"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="이전 날"/>

                <TextView
                    android:id="@+id/tv_todo_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2025년 4월 11일 To-do"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <ImageView
                    android:id="@+id/btn_next_day"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_baseline_arrow_forward_ios_24"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="다음 날"/>

            </LinearLayout>

            <!-- 루틴 섹션 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="루틴"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#B2DFDB"
                android:layout_marginBottom="4dp"/>

            <!-- 루틴 목록 -->
            <LinearLayout
                android:id="@+id/ll_routine_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"/>

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="#F0EFE8"
                android:layout_marginBottom="12dp"/>

            <!-- 리스트 섹션 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="리스트"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#B2DFDB"
                android:layout_marginBottom="4dp"/>

            <!-- 리스트 목록 -->
            <LinearLayout
                android:id="@+id/ll_list_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

        <!-- 월 선택 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_prev_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_month_btn"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="이전 달"/>

            <TextView
                android:id="@+id/tv_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="4월"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2C2C2A"/>

            <ImageView
                android:id="@+id/btn_next_month"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_month_btn"
                android:clickable="true"
                android:contentDescription="다음 달"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_arrow_forward_ios_24" />

        </LinearLayout>

        <!-- 요일 라벨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="28dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="일" android:textSize="11sp" android:textColor="#E57373" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="월" android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="화" android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="수" android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="목" android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="금" android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="토" android:textSize="11sp" android:textColor="#5C8BDA" android:textStyle="bold"/>

        </LinearLayout>

        <!-- 잔디 달력 -->
        <LinearLayout
            android:id="@+id/ll_grass_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"/>

        <!-- 범례 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="적음"
                android:textSize="9sp"
                android:textColor="#888780"
                android:layout_marginEnd="4dp"/>

            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/bg_calendar_empty"
                android:layout_marginEnd="3dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/bg_calendar_level1"
                android:layout_marginEnd="3dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/bg_calendar_level2"
                android:layout_marginEnd="3dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/bg_calendar_level3"
                android:layout_marginEnd="3dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/bg_calendar_level4"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="많음"
                android:textSize="9sp"
                android:textColor="#888780"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>