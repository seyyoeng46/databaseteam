<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_routine_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- 날짜 -->
    <TextView
        android:id="@+id/tv_diary_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026.04.11 (토)"
        android:textSize="11sp"
        android:textColor="#B0B0B0"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <!-- 태그 목록 -->
    <LinearLayout
        android:id="@+id/layout_diary_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"/>

    <!-- 일기 제목 -->
    <TextView
        android:id="@+id/tv_diary_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="일기 제목"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#2C2C2A"
        android:layout_marginBottom="6dp"/>

    <!-- 일기 미리보기 -->
    <TextView
        android:id="@+id/tv_diary_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="일기 내용 미리보기..."
        android:textSize="12sp"
        android:textColor="#888780"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp"/>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#F0EFE8"
        android:layout_marginBottom="10dp"/>

    <!-- 수정/삭제 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_diary_edit"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="수정"
            android:textSize="12sp"
            android:textColor="#639922"
            android:background="@drawable/bg_btn_edit"
            android:stateListAnimator="@null"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_diary_delete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="삭제"
            android:textSize="12sp"
            android:textColor="#A32D2D"
            android:background="@drawable/bg_btn_delete"
            android:stateListAnimator="@null"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

    </LinearLayout>

</LinearLayout>