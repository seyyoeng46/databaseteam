<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- 핸들 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_sheet_handle"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <!-- 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="어떤 걸 만들까요?"
        android:textSize="13sp"
        android:textColor="#B0B0B0"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <!-- 루틴 만들기 -->
    <LinearLayout
        android:id="@+id/option_routine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_option"
        android:padding="14dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_option_icon_green"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_routine"
                android:contentDescription="루틴"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="루틴 만들기"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2C2C2A"
                android:layout_marginBottom="3dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="알람과 요일을 설정한 반복 루틴"
                android:textSize="11sp"
                android:textColor="#888780"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 리스트 만들기 -->
    <LinearLayout
        android:id="@+id/option_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_option"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_option_icon_blue"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_diary"
                android:contentDescription="리스트"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="리스트 만들기"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2C2C2A"
                android:layout_marginBottom="3dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘 할 일을 직접 추가하는 투두 리스트"
                android:textSize="11sp"
                android:textColor="#888780"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>