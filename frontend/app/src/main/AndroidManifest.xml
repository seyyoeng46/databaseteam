<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 사진 등록 기능 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- 시작 화면: 로그인 -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 메인 화면: 하단 네비게이션 -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 루틴 시작 화면 -->
        <activity
            android:name=".RoutineCreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 투두 생성 화면 추가 -->
        <activity
            android:name=".TodoCreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".TodoDetailActivity" />

        <activity android:name=".DiaryWriteActivity" />

        <!-- 알람 설정 -->
        <activity
            android:name=".AlarmEditActivity"
            android:exported="false" />

        <activity
            android:name=".RoutineEditActivity"
            android:exported="false" />

        <activity
            android:name=".RoutineCreateManualActivity"
            android:exported="false"/>

        <activity android:name=".TodoEditActivity" android:exported="false"/>

    </application>

</manifest>